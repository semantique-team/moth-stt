# Python
__pycache__/
*.py[cod]
.venv/
.venv-baselines/
.venv-whistle/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Project artifacts (never in git) — except the curated term list, the data README and the manifests
data/*
!data/en_terms.txt
!data/README.md
!data/manifests/
models/
release/
*.onnx
# ...except the vendored Silero VAD (MIT, 2.33 MB) that ships with the runtime
!stt/assets/silero_vad.onnx
runs/**/ckpt*.pt
# E-019: the LoRA adapter (6.5 MB) and the exported .cact (28 MB) are rebuilt by the scripts;
# the 220.6 MB training checkpoint and the smoke adapters are never committed.
runs/E-019/*.safetensors
runs/E-019/*.cact
runs/E-019/smoke/
checkpoints/

# Web
web/node_modules/
web/test-results/
web/playwright-report/
baselines/runs/*.log

# Agent session scratch (stdout dumps, orchestration logs: regenerable, not an experiment record)
runs/*.log
runs/*.txt
runs/**/*.out
runs/orchestrate.*

# Recordings (audio, candidates and cue sheets are not versioned; scripts and manifests are)
recordings/audio/
recordings/candidates/
recordings/cues/

# macOS / editors
.DS_Store
.idea/
.vscode/

# Incoming external recordings (personal data: archivi e staging, mai in git)
recordings/incoming/

# E-031: frozen LM corpus and built LM binaries are reproducible from committed inputs/scripts
runs/E-031/frozen/lm-corpus.jsonl
runs/E-031/probe/*.bin
runs/E-031/build/*.bin
runs/E-031/build/*.pkl.gz
runs/E-031/decoder-parity/logits.bin

# E-028 quantization sweep: derived ONNX variants, never committed
runs/E-028/quant/*.onnx

# E-034: LM variants are reproducible from the pinned corpus and build_variants.py
runs/E-034/build/*.bin
runs/E-034/build/*.pkl.gz
